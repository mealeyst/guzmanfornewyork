# Google Analytics Measurement ID
# Get this from your Google Analytics property settings
# Format: G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Web3Forms access key — receives volunteer & contact form submissions
# Get this from https://web3forms.com (verify the destination inbox for Guzman 4 New York)
PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here
