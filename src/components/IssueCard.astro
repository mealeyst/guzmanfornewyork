---
interface Props {
    icon: string;
    title: string;
    summary: string;
}

const { icon, title, summary } = Astro.props;
---

<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
    <div class="flex items-center gap-3 mb-3">
        <svg class="w-8 h-8 text-brand-navy shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <Fragment set:html={icon} />
        </svg>
        <h3 class="text-lg font-bold text-brand-navy font-heading">{title}</h3>
    </div>
    <p class="text-gray-600 text-sm leading-relaxed">{summary}</p>
</div>
