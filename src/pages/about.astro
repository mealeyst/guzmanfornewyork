---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Slideshow from "@/components/Slideshow";

const base = import.meta.env.BASE_URL;

const slideshowImages = [
    { src: `${base}images/daniel-headshot-official.jpg`, alt: "Official portrait of Daniel Guzman" },
    {
        src: `${base}images/daniel-dress-blues-speech.jpg`,
        alt: "Daniel Guzman speaking in his U.S. Marine Corps dress uniform in front of an American flag",
    },
    {
        src: `${base}images/daniel-veteran-ceremony.jpg`,
        alt: "Daniel Guzman with a fellow Marine Corps veteran at a ceremony",
    },
    { src: `${base}images/daniel-with-mother.jpg`, alt: "Daniel Guzman with his mother at a military ceremony" },
];
---

<BaseLayout
    title="About Daniel"
    description="Daniel Guzman is a disabled combat veteran and community leader running for New York State Assembly, 94th District."
>
    <!-- Page Header -->
    <section class="bg-brand-navy text-white py-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
            <h1 class="font-heading text-4xl sm:text-5xl font-bold mb-4">About Daniel Guzman</h1>
            <p class="text-xl text-blue-200 max-w-2xl mx-auto">
                Marine veteran. Community leader. Putting people first in the 94th District.
            </p>
        </div>
    </section>

    <!-- Bio Section -->
    <section class="py-20 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 grid md:grid-cols-2 gap-12 items-start">
            <!-- Photos -->
            <div class="md:sticky md:top-32">
                <Slideshow client:load images={slideshowImages} />
            </div>

            <!-- Bio Content -->
            <div>
                <h2 class="font-heading text-3xl font-bold text-brand-navy mb-6">Service Over Politics</h2>
                <div class="space-y-4 text-gray-700 leading-relaxed">
                    <p>
                        Daniel Guzman is a disabled combat veteran with nearly 40 years of community
                        service. He's running for New York State Assembly in the 94th District — covering
                        Westchester and Putnam Counties — to bring disciplined, accountable leadership
                        back to Albany.
                    </p>
                    <p>
                        &ldquo;I'm a disabled combat veteran with nearly 40 years of community service,
                        running to bring accountable leadership back to Albany. I will fight for all
                        families, schools, and safer neighborhoods in Westchester and Putnam
                        Counties.&rdquo;
                    </p>
                </div>

                <h2 class="font-heading text-3xl font-bold text-brand-navy mt-10 mb-6">A Marine's Commitment to Service</h2>
                <div class="space-y-4 text-gray-700 leading-relaxed">
                    <p>
                        Daniel's commitment to service began in the United States Marine Corps, where he
                        served as a combat veteran. That same discipline and dedication now drives his
                        campaign — putting people first, and bringing the same accountability he learned
                        in uniform to New York State government.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Values Section -->
    <section class="py-20 bg-brand-light">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <h2 class="font-heading text-3xl sm:text-4xl font-bold text-brand-navy mb-4">Daniel's Values</h2>
            </div>
            <div class="grid sm:grid-cols-3 gap-6">
                {
                    [
                        {
                            title: "Service",
                            desc: "Daniel's nearly 40 years of community service — grounded in his time as a U.S. Marine — shape a campaign built on service over politics.",
                        },
                        {
                            title: "Accountability",
                            desc: "Daniel believes elected officials answer to the people who elect them. He's running to bring disciplined, accountable leadership back to Albany.",
                        },
                        {
                            title: "Community",
                            desc: "From Westchester to Putnam County, Daniel is committed to putting people first — families, schools, and safer neighborhoods for every resident of the 94th District.",
                        },
                    ].map((value) => (
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-center">
                            <h3 class="font-heading text-xl font-bold text-brand-navy mb-3">{value.title}</h3>
                            <p class="text-gray-600 text-sm leading-relaxed">{value.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-brand-navy text-white text-center">
        <div class="max-w-2xl mx-auto px-4 sm:px-6">
            <h2 class="font-heading text-2xl font-bold mb-4">Ready to support Daniel?</h2>
            <p class="text-blue-200 mb-6">
                Every door knock, phone call, and dollar donated makes a difference.
            </p>
            <div class="flex flex-wrap gap-4 justify-center">
                <a
                    href={`${base}get-involved`}
                    class="bg-brand-red hover:bg-red-700 text-white px-6 py-3 rounded font-semibold transition-colors"
                >
                    Get Involved
                </a>
                <a
                    href={`${base}contact`}
                    class="border-2 border-white text-white hover:bg-white hover:text-brand-navy px-6 py-3 rounded font-semibold transition-colors"
                >
                    Contact Daniel
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
