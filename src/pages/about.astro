---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Slideshow from "@/components/Slideshow";

const base = import.meta.env.BASE_URL;

const slideshowImages = [
    { src: `${base}images/daniel-headshot-official.jpg`, alt: "Official portrait of Daniel Guzman" },
    {
        src: `${base}images/daniel-dress-blues-speech.jpg`,
        alt: "Daniel Guzman speaking in his U.S. Marine Corps dress uniform in front of an American flag",
    },
    {
        src: `${base}images/daniel-veteran-ceremony.jpg`,
        alt: "Daniel Guzman with a fellow Marine Corps veteran at a ceremony",
    },
    { src: `${base}images/daniel-with-mother.jpg`, alt: "Daniel Guzman with his mother at a military ceremony" },
];
---

<!--
    Bio content sourced from the campaign's official press release
    ("FOR-RELEASE-Daniel-Guzman-for-State-Assembly.pdf"). The press release
    describes Daniel as "a 30-year community advocate," while his existing
    campaign flyer quotes him as having "nearly 40 years of community
    service" — both are kept verbatim in their original context below
    rather than reconciled, since they come from two different official
    campaign materials.
-->
<BaseLayout
    title="About Daniel"
    description="Daniel Guzman — Marine combat veteran, union worker, and community leader from the South Bronx — is running to make history in New York's 94th Assembly District."
>
    <!-- Page Header -->
    <section class="bg-brand-navy text-white py-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
            <h1 class="font-heading text-4xl sm:text-5xl font-bold mb-4">About Daniel Guzman</h1>
            <p class="text-xl text-blue-200 max-w-2xl mx-auto">
                Marine combat veteran. Union worker. Community leader. Putting people first in the
                94th District.
            </p>
        </div>
    </section>

    <!-- Bio Section -->
    <section class="py-20 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 grid md:grid-cols-2 gap-12 items-start">
            <!-- Photos -->
            <div class="flex justify-center md:block md:sticky md:top-32">
                <Slideshow client:load images={slideshowImages} />
            </div>

            <!-- Bio Content -->
            <div>
                <h2 class="font-heading text-3xl font-bold text-brand-navy mb-6">From the South Bronx to Putnam County</h2>
                <div class="space-y-4 text-gray-700 leading-relaxed">
                    <p>
                        Daniel Guzman was raised in the South Bronx before spending eight years in the
                        United States Marine Corps, including two tours overseas and one combat tour in
                        Iraq. Ten years ago he settled in Patterson, where he and his wife are raising
                        their two boys in the Carmel schools. Daniel currently works as a custodian in
                        the Mahopac school district.
                    </p>
                    <p>
                        &ldquo;I'm a combat Marine veteran with nearly 40 years of community service,
                        running to bring accountable leadership back to Albany. I will fight for all
                        families, schools, and safer neighborhoods in Westchester and Putnam
                        Counties.&rdquo;
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Making History -->
    <section class="py-16 bg-brand-navy text-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="grid sm:grid-cols-3 gap-8 text-center">
                <div>
                    <div class="font-heading text-4xl font-bold text-white mb-2">8 Years</div>
                    <p class="text-blue-200 text-sm">Served in the U.S. Marine Corps, including a combat tour in Iraq</p>
                </div>
                <div>
                    <div class="font-heading text-4xl font-bold text-white mb-2">100+ Years</div>
                    <p class="text-blue-200 text-sm">Since a Democrat has represented this gerrymandered Assembly seat</p>
                </div>
                <div>
                    <div class="font-heading text-4xl font-bold text-white mb-2">A First</div>
                    <p class="text-blue-200 text-sm">Daniel would be the first Latino and first combat veteran to represent NY's 94th District</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Building Community -->
    <section class="py-20 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 grid md:grid-cols-2 gap-12 items-center">
            <div>
                <h2 class="font-heading text-3xl font-bold text-brand-navy mb-6">Building Community</h2>
                <div class="space-y-4 text-gray-700 leading-relaxed">
                    <p>
                        In 2014, Daniel founded Musart Music Management, creating opportunities and
                        resources for emerging artists. In 2023, he expanded his community work by
                        founding Palante Para Todos, a nonprofit serving communities through mental
                        health advocacy, food distribution, youth outreach, and multicultural community
                        events across New York and Florida. He still leads both organizations today.
                    </p>
                    <p>
                        As a proud Puerto Rican, Daniel has created programs and events that celebrate
                        his culture — teaching dance and music to youth and organizing celebrations that
                        bring families closer to their heritage. His dedication to service has earned him
                        a Certificate of Merit from the Mayor's Office, a citation from the Bronx Borough
                        President, and a New York Senate proclamation.
                    </p>
                </div>
            </div>
            <div>
                <img
                    src={`${base}images/daniel-community-photo.jpg`}
                    alt="Daniel Guzman in his Putnam County community"
                    class="w-full rounded-2xl shadow-lg border border-gray-200 object-cover"
                />
            </div>
        </div>
    </section>

    <!-- Fighting for Working Families -->
    <section class="py-20 bg-brand-light">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
            <h2 class="font-heading text-3xl font-bold text-brand-navy mb-6">Fighting for Working Families</h2>
            <p class="text-gray-700 leading-relaxed">
                As a union worker, Daniel has personally fought for dignity in the workplace, fair
                treatment, and accountability. He understands the needs of working families because he
                lives that life — juggling schedules and family duties in pursuit of the American
                dream. In Albany, he will advocate for policies to improve wages, reduce the cost
                burden on families, and expand services like childcare that keep working families
                working.
            </p>
        </div>
    </section>

    <!-- Marine's Commitment to Service -->
    <section class="py-20 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
            <h2 class="font-heading text-3xl font-bold text-brand-navy mb-6">A Marine's Commitment to Service</h2>
            <p class="text-gray-700 leading-relaxed">
                Daniel's commitment to service began in the United States Marine Corps, where he
                completed a combat tour in Iraq. Like many who serve, he faced his own challenges
                coming home from war — and that experience shapes his understanding of what veterans
                need to succeed here at home. He is a strong believer in mental health and social
                support programs, and will advocate for state funding and partnerships to expand
                services for veterans.
            </p>
        </div>
    </section>

    <!-- Values Section -->
    <section class="py-20 bg-brand-light">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <h2 class="font-heading text-3xl sm:text-4xl font-bold text-brand-navy mb-4">Daniel's Values</h2>
            </div>
            <div class="grid sm:grid-cols-3 gap-6">
                {
                    [
                        {
                            title: "Service",
                            desc: "From eight years in the Marine Corps to founding two community organizations, Daniel's life has been shaped by service over politics.",
                        },
                        {
                            title: "Accountability",
                            desc: "Daniel believes elected officials answer to the people who elect them. He's running to bring disciplined, accountable leadership back to Albany.",
                        },
                        {
                            title: "Community",
                            desc: "From the South Bronx to Putnam County, Daniel has spent his life building community — through his nonprofit work, his culture, and his neighbors.",
                        },
                    ].map((value) => (
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-center">
                            <h3 class="font-heading text-xl font-bold text-brand-navy mb-3">{value.title}</h3>
                            <p class="text-gray-600 text-sm leading-relaxed">{value.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-brand-navy text-white text-center">
        <div class="max-w-2xl mx-auto px-4 sm:px-6">
            <h2 class="font-heading text-2xl font-bold mb-4">Ready to support Daniel?</h2>
            <p class="text-blue-200 mb-6">
                Every door knock, phone call, and dollar donated makes a difference.
            </p>
            <div class="flex flex-wrap gap-4 justify-center">
                <a
                    href={`${base}get-involved`}
                    class="bg-brand-red hover:bg-red-700 text-white px-6 py-3 rounded font-semibold transition-colors"
                >
                    Get Involved
                </a>
                <a
                    href={`${base}contact`}
                    class="border-2 border-white text-white hover:bg-white hover:text-brand-navy px-6 py-3 rounded font-semibold transition-colors"
                >
                    Contact Daniel
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
