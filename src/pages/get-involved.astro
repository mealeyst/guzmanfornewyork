---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Slideshow from "@/components/Slideshow";
import VolunteerForm from "@/components/VolunteerForm";

const eventSlideshowImages = [
    { src: "/images/campaign-banner-supporters.jpg", alt: "Daniel Guzman with supporters at a campaign gathering" },
    { src: "/images/campaign-photobooth-group.jpg", alt: "Supporters at a Daniel Guzman campaign event" },
    { src: "/images/campaign-summer-gathering.jpg", alt: "Guests at a #VoteGuzman campaign gathering" },
];
---

<BaseLayout
    title="Get Involved"
    description="Volunteer, donate, or sign up to support Daniel Guzman for New York State Assembly, 94th District."
>
    <!-- Page Header -->
    <section class="bg-brand-navy text-white py-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 grid md:grid-cols-2 gap-12 items-center">
            <div>
                <h1 class="font-heading text-4xl sm:text-5xl font-bold mb-4">Get Involved</h1>
                <p class="text-xl text-blue-200">
                    Elections are won one conversation at a time. Join the campaign and help bring
                    accountable leadership back to Albany.
                </p>
            </div>
            <div class="flex justify-center">
                <Slideshow
                    client:load
                    images={eventSlideshowImages}
                    className="max-w-md"
                    activeDotClass="bg-white"
                />
            </div>
        </div>
    </section>

    <!-- Ways to Help -->
    <section class="py-20 bg-brand-light">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <h2 class="font-heading text-3xl font-bold text-brand-navy text-center mb-12">
                Ways You Can Help
            </h2>
            <div class="grid sm:grid-cols-3 gap-6">
                {
                    [
                        {
                            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>`,
                            title: "Canvass",
                            desc: "Knock on doors with us! Canvassing is the most effective way to reach voters across the 94th District. Training provided — all skill levels welcome.",
                        },
                        {
                            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
                            title: "Phone Bank",
                            desc: "Help us call voters from the comfort of your home. We'll provide the script and the list.",
                        },
                        {
                            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>`,
                            title: "Spread the Word",
                            desc: "Share #VoteGuzman on social media, put up a yard sign, or talk to your neighbors about the 94th District's future.",
                        },
                    ].map((way) => (
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-center">
                            <div class="flex justify-center mb-4">
                                <svg class="w-10 h-10 text-brand-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <Fragment set:html={way.icon} />
                                </svg>
                            </div>
                            <h3 class="font-heading text-xl font-bold text-brand-navy mb-2">{way.title}</h3>
                            <p class="text-gray-600 text-sm leading-relaxed">{way.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Volunteer Sign-Up Form -->
    <section id="volunteer" class="py-20 bg-white">
        <div class="max-w-xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-10">
                <h2 class="font-heading text-3xl font-bold text-brand-navy mb-4">Sign Up to Volunteer</h2>
                <p class="text-gray-600">
                    Fill out the form below and a member of the campaign team will be in touch.
                </p>
            </div>
            <VolunteerForm client:load />
        </div>
    </section>

    <!-- Donate Section -->
    <section id="donate" class="py-20 bg-brand-navy text-white">
        <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
            <h2 class="font-heading text-3xl font-bold mb-4">Donate to the Campaign</h2>
            <p class="text-blue-200 mb-8 leading-relaxed">
                Campaign contributions help us print materials, canvass the district, and get
                Daniel's message out to more voters. Every dollar counts.
            </p>

            <!-- Donation amount buttons -->
            <div class="flex flex-wrap gap-3 justify-center mb-8">
                {
                    [
                        { label: "$10", amount: "10" },
                        { label: "$25", amount: "25" },
                        { label: "$50", amount: "50" },
                        { label: "$100", amount: "100" },
                        { label: "$250", amount: "250" },
                        { label: "Other", amount: null },
                    ].map(({ label, amount }) => {
                        const refcode = amount ? `getinvolved_${amount}` : "getinvolved_other";
                        const params = new URLSearchParams();
                        if (amount) params.set("amount", amount);
                        params.set("refcode", refcode);
                        const href = `https://secure.actblue.com/donate/guzman2026?${params.toString()}`;
                        return (
                            <a
                                href={href}
                                class="bg-white/10 hover:bg-white/20 border border-white/30 text-white px-5 py-3 rounded font-semibold transition-colors min-w-[4rem]"
                            >
                                {label}
                            </a>
                        );
                    })
                }
            </div>

            <a
                href="https://secure.actblue.com/donate/guzman2026?refcode=getinvolved_main"
                class="inline-block bg-brand-red hover:bg-red-700 text-white px-8 py-4 rounded font-bold text-xl transition-colors"
            >
                Donate Now
            </a>

            <p class="mt-6 text-xs text-blue-300">Paid for by Guzman 4 New York.</p>
        </div>
    </section>
</BaseLayout>
