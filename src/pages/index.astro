---
import BaseLayout from "@/layouts/BaseLayout.astro";
import IssueCard from "@/components/IssueCard.astro";
---

<BaseLayout title="Home">
    <!-- Hero Section -->
    <section class="relative bg-white overflow-hidden border-b border-gray-100">
        <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-10 grid md:grid-cols-2 gap-12 items-center">
            <div>
                <div class="inline-block bg-brand-red text-white text-sm font-semibold px-3 py-1 rounded mb-4">
                    NY State Assembly &middot; 94th District
                </div>
                <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-brand-navy">
                    Putting People First
                </h1>
                <p class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-8">
                    Daniel Guzman is a disabled combat veteran with nearly 40 years of community
                    service, running to bring accountable leadership back to Albany. He will fight
                    for all families, schools, and safer neighborhoods in Westchester and Putnam
                    Counties.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a
                        href="/get-involved"
                        class="bg-brand-red hover:bg-red-700 text-white px-6 py-3 rounded font-semibold text-lg transition-colors"
                    >
                        Get Involved
                    </a>
                    <a
                        href="/about"
                        class="border-2 border-brand-navy text-brand-navy hover:bg-brand-navy hover:text-white px-6 py-3 rounded font-semibold text-lg transition-colors"
                    >
                        Meet Daniel
                    </a>
                </div>
            </div>

            <!-- Candidate photo -->
            <div class="flex justify-center">
                <img
                    src="/images/daniel-dress-blues-speech.jpg"
                    alt="Daniel Guzman, a disabled combat veteran, speaking in his U.S. Marine Corps dress uniform in front of an American flag"
                    class="w-72 sm:w-80 rounded-2xl shadow-xl object-cover border border-gray-200"
                />
            </div>
        </div>
    </section>

    <!-- Issues Preview -->
    <section class="py-20 bg-brand-light">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <h2 class="font-heading text-3xl sm:text-4xl font-bold text-brand-navy mb-4">
                    Service Over Politics
                </h2>
                <p class="text-gray-600 text-lg max-w-3xl mx-auto">
                    Daniel believes the 94th District deserves disciplined, accountable leadership —
                    not politics as usual. Here's where he stands.
                </p>
            </div>
            <div class="grid sm:grid-cols-2 gap-6">
                <IssueCard
                    icon={`<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.32-.21-2.593-.598-3.75h-.152c-3.196 0-6.1-1.248-8.25-3.286z" />`}
                    title="Veterans & Public Safety"
                    summary="As a disabled combat veteran himself, Daniel will fight for the resources our veterans, first responders, and neighborhoods need to be safe and supported."
                />
                <IssueCard
                    icon={`<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />`}
                    title="Strong Public Schools"
                    summary="Every family in the 94th District deserves access to great public schools. Daniel will push Albany to fully fund the classrooms our kids depend on."
                />
                <IssueCard
                    icon={`<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />`}
                    title="Supporting Working Families"
                    summary="Westchester and Putnam families are being priced out of the communities they grew up in. Daniel will fight to keep housing, health care, and everyday life affordable."
                />
                <IssueCard
                    icon={`<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971z" />`}
                    title="Accountable Leadership"
                    summary="Daniel is running to bring disciplined, accountable leadership back to Albany — service over politics, and results over talking points."
                />
            </div>
            <div class="text-center mt-10">
                <a
                    href="/issues"
                    class="inline-block bg-brand-navy hover:bg-blue-900 text-white px-6 py-3 rounded font-semibold transition-colors"
                >
                    See Full Platform
                </a>
            </div>
        </div>
    </section>

    <!-- On the Trail / Quote Section -->
    <section class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-16">
                <blockquote class="text-xl text-brand-navy leading-relaxed italic mb-6">
                    &ldquo;I'm a disabled combat veteran with nearly 40 years of community service,
                    running to bring accountable leadership back to Albany. I will fight for all
                    families, schools, and safer neighborhoods in Westchester and Putnam
                    Counties.&rdquo;
                </blockquote>
                <p class="text-brand-navy font-semibold text-sm">&mdash; Daniel Guzman</p>
            </div>

            <div class="flex justify-center">
                <img
                    src="/images/daniel-canvassing.jpg"
                    alt="Daniel Guzman canvassing alongside fellow Hudson Valley candidates"
                    class="w-full max-w-2xl rounded-2xl shadow-lg border border-gray-200 object-cover"
                />
            </div>
        </div>
    </section>

    <!-- Get Involved CTA -->
    <section class="py-20 bg-brand-navy text-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
            <h2 class="font-heading text-3xl sm:text-4xl font-bold mb-4">#VoteGuzman</h2>
            <p class="text-lg text-blue-200 mb-8 max-w-xl mx-auto">
                Volunteer, donate, or spread the word. Together we can bring the 94th District the
                accountable leadership it deserves.
            </p>
            <div class="flex flex-wrap gap-4 justify-center">
                <a
                    href="/get-involved#volunteer"
                    class="bg-white text-brand-navy hover:bg-blue-50 px-6 py-3 rounded font-semibold text-lg transition-colors"
                >
                    Volunteer
                </a>
                <a
                    href="/get-involved#donate"
                    class="border-2 border-white text-white hover:bg-white hover:text-brand-navy px-6 py-3 rounded font-semibold text-lg transition-colors"
                >
                    Donate
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
