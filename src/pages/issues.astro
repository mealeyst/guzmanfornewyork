---
import BaseLayout from "@/layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<!--
    NOTE: This page's four pillars are placeholders derived from Daniel's
    existing tagline/quote ("families, schools, safer neighborhoods,
    accountable leadership"). Replace the bullet points below with Daniel's
    actual policy positions before launch.
-->
<BaseLayout
    title="The Issues"
    description="Daniel Guzman's platform for New York State Assembly, 94th District — veterans & public safety, strong schools, working families, and accountable leadership."
>
    <!-- Page Header -->
    <section class="bg-brand-navy text-white py-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
            <h1 class="font-heading text-4xl sm:text-5xl font-bold mb-4">The Issues</h1>
            <p class="text-xl text-blue-200 max-w-2xl mx-auto">
                Service over politics for the families of Westchester and Putnam Counties.
            </p>
        </div>
    </section>

    <!-- Pillar 1: Veterans & Public Safety -->
    <section id="public-safety" class="py-20" style="background-color: rgba(10,31,68,0.05);">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="flex items-start gap-6">
                <div class="w-14 h-14 shrink-0 rounded-xl flex items-center justify-center" style="background-color: rgba(10,31,68,0.12);">
                    <svg class="w-7 h-7" fill="none" stroke="#0a1f44" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.32-.21-2.593-.598-3.75h-.152c-3.196 0-6.1-1.248-8.25-3.286z"></path>
                    </svg>
                </div>
                <div class="flex-1">
                    <h2 class="font-heading text-3xl font-bold text-brand-navy mb-6">Veterans & Public Safety</h2>
                    <p class="text-gray-700 leading-relaxed mb-8">
                        As a disabled combat veteran, Daniel knows firsthand what our veterans and first
                        responders need to thrive after their service. He'll fight to make sure Westchester
                        and Putnam neighborhoods are safe places to raise a family.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
                        <ul class="space-y-4 md:order-1 order-2">
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(10,31,68,0.08);">
                                <span class="font-bold text-lg mt-0.5" style="color: #0a1f44;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Expand access to services and benefits for disabled and combat veterans.</p>
                            </li>
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(10,31,68,0.08);">
                                <span class="font-bold text-lg mt-0.5" style="color: #0a1f44;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Support first responders and volunteer fire departments across the district.</p>
                            </li>
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(10,31,68,0.08);">
                                <span class="font-bold text-lg mt-0.5" style="color: #0a1f44;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Push for safer neighborhoods in every community in the 94th District.</p>
                            </li>
                        </ul>
                        <figure class="h-full flex flex-col md:order-2 order-1">
                            <img
                                src={`${base}images/campaign-summer-gathering.jpg`}
                                alt="Daniel Guzman with supporters at a campaign gathering"
                                class="w-full flex-1 min-h-0 rounded-xl shadow-md object-cover"
                            />
                            <figcaption class="text-sm text-gray-500 mt-2 text-center">
                                Daniel with supporters in the 94th District.
                            </figcaption>
                        </figure>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pillar 2: Strong Public Schools -->
    <section id="schools" class="py-20" style="background-color: rgba(200,16,46,0.05);">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="flex items-start gap-6">
                <div class="w-14 h-14 shrink-0 rounded-xl flex items-center justify-center" style="background-color: rgba(200,16,46,0.1);">
                    <svg class="w-7 h-7" fill="none" stroke="#c8102e" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"></path>
                    </svg>
                </div>
                <div class="flex-1">
                    <h2 class="font-heading text-3xl font-bold text-brand-navy mb-6">Strong Public Schools</h2>
                    <p class="text-gray-700 leading-relaxed mb-8">
                        Every family in the 94th District deserves access to great public schools. Daniel
                        will push Albany to fully fund the classrooms our kids depend on.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
                        <figure class="h-full flex flex-col">
                            <img
                                src={`${base}images/campaign-photobooth-1.jpg`}
                                alt="Daniel Guzman with community members at a campaign event"
                                class="w-full flex-1 min-h-0 rounded-xl shadow-md object-cover"
                            />
                            <figcaption class="text-sm text-gray-500 mt-2 text-center">
                                Building a coalition of families, educators, and neighbors.
                            </figcaption>
                        </figure>
                        <ul class="space-y-4">
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(200,16,46,0.07);">
                                <span class="font-bold text-lg mt-0.5" style="color: #c8102e;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Fight for full and fair school funding for the 94th District.</p>
                            </li>
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(200,16,46,0.07);">
                                <span class="font-bold text-lg mt-0.5" style="color: #c8102e;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Support teachers and school staff who show up for our kids every day.</p>
                            </li>
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(200,16,46,0.07);">
                                <span class="font-bold text-lg mt-0.5" style="color: #c8102e;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Give families a voice in decisions that affect their children's education.</p>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pillar 3: Supporting Working Families -->
    <section id="families" class="py-20" style="background-color: rgba(10,31,68,0.05);">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="flex items-start gap-6">
                <div class="w-14 h-14 shrink-0 rounded-xl flex items-center justify-center" style="background-color: rgba(10,31,68,0.12);">
                    <svg class="w-7 h-7" fill="none" stroke="#0a1f44" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"></path>
                    </svg>
                </div>
                <div class="flex-1">
                    <h2 class="font-heading text-3xl font-bold text-brand-navy mb-6">Supporting Working Families</h2>
                    <p class="text-gray-700 leading-relaxed mb-8">
                        Westchester and Putnam families are being priced out of the communities they grew
                        up in. Daniel will fight to keep housing, health care, and everyday life
                        affordable.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
                        <ul class="space-y-4 md:order-1 order-2">
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(10,31,68,0.08);">
                                <span class="font-bold text-lg mt-0.5" style="color: #0a1f44;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Champion affordable housing options for working families.</p>
                            </li>
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(10,31,68,0.08);">
                                <span class="font-bold text-lg mt-0.5" style="color: #0a1f44;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Fight rising costs that put affordable living out of reach.</p>
                            </li>
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(10,31,68,0.08);">
                                <span class="font-bold text-lg mt-0.5" style="color: #0a1f44;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Support small businesses that anchor our Main Streets.</p>
                            </li>
                        </ul>
                        <figure class="h-full flex flex-col md:order-2 order-1">
                            <img
                                src={`${base}images/campaign-photobooth-2.jpg`}
                                alt="Daniel Guzman with community members at a campaign event"
                                class="w-full flex-1 min-h-0 rounded-xl shadow-md object-cover"
                            />
                            <figcaption class="text-sm text-gray-500 mt-2 text-center">
                                Neighbors coming together for the 94th District.
                            </figcaption>
                        </figure>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pillar 4: Accountable Leadership -->
    <section id="accountability" class="py-20" style="background-color: rgba(200,16,46,0.05);">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="flex items-start gap-6">
                <div class="w-14 h-14 shrink-0 rounded-xl flex items-center justify-center" style="background-color: rgba(200,16,46,0.1);">
                    <svg class="w-7 h-7" fill="none" stroke="#c8102e" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971z"></path>
                    </svg>
                </div>
                <div class="flex-1">
                    <h2 class="font-heading text-3xl font-bold text-brand-navy mb-6">Accountable Leadership</h2>
                    <p class="text-gray-700 leading-relaxed mb-8">
                        Daniel is running to bring disciplined, accountable leadership back to Albany —
                        service over politics, and results over talking points.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
                        <figure class="h-full flex flex-col">
                            <img
                                src={`${base}images/campaign-photobooth-3.jpg`}
                                alt="Daniel Guzman with community members at a campaign event"
                                class="w-full flex-1 min-h-0 rounded-xl shadow-md object-cover"
                            />
                            <figcaption class="text-sm text-gray-500 mt-2 text-center">
                                The People's Guzman — grassroots support across the district.
                            </figcaption>
                        </figure>
                        <ul class="space-y-4">
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(200,16,46,0.07);">
                                <span class="font-bold text-lg mt-0.5" style="color: #c8102e;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Bring discipline and transparency to how Albany serves the 94th District.</p>
                            </li>
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(200,16,46,0.07);">
                                <span class="font-bold text-lg mt-0.5" style="color: #c8102e;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Stay accessible and accountable to the people he represents.</p>
                            </li>
                            <li class="flex items-start gap-3 rounded-xl p-5" style="background-color: rgba(200,16,46,0.07);">
                                <span class="font-bold text-lg mt-0.5" style="color: #c8102e;">•</span>
                                <p class="text-gray-700" style="margin-top: 4px;">Put service over politics in every decision he makes in Albany.</p>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-brand-navy text-white text-center">
        <div class="max-w-2xl mx-auto px-4 sm:px-6">
            <h2 class="font-heading text-2xl font-bold mb-4">These issues matter to you too?</h2>
            <p class="text-blue-200 mb-6">
                Help Daniel carry this message to every doorstep in the 94th District.
            </p>
            <a
                href={`${base}get-involved`}
                class="inline-block bg-white text-brand-navy hover:bg-blue-50 px-6 py-3 rounded font-semibold text-lg transition-colors"
            >
                Get Involved Today
            </a>
        </div>
    </section>
</BaseLayout>
